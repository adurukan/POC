        "title",
        "source_filename",
        "source_path"
      ]
    },
    "document_sections": {
      "file": "document_sections.json",
      "required": [
        "document_file_sha256",
        "slug",
        "section_index",
        "title",
        "page_start",
        "page_end"
      ]
    },
    "section_knowledge_packs": {
      "file": "section_knowledge_packs.json",
      "required": [
        "document_file_sha256",
        "section_slug",
        "slug",
        "title",
        "source_pages",
        "markdown_content",
        "markdown_file_path",
        "review_status"
      ]
    },
    "pending_questions": {
      "file": "pending_questions.json",
      "required": [
        "request_id",
        "grade",
        "subject",
